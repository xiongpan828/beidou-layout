{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "beidou-layout values",
  "type": "object",
  "required": [
    "image",
    "config",
    "defaults",
    "services",
    "namespace"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "registry",
        "pullPolicy"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "config": {
      "type": "object",
      "description": "配置文件 / env 模板变量（files/config/<服务>/*）",
      "required": [
        "domain",
        "db_host",
        "db_port",
        "db_password",
        "db_sslmode",
        "storage_sign_secret"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "db_host": {
          "type": "string",
          "minLength": 1
        },
        "db_port": {
          "type": "integer"
        },
        "db_password": {
          "type": "string",
          "minLength": 1
        },
        "db_sslmode": {
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "storage_sign_secret": {
          "type": "string",
          "minLength": 1,
          "description": "对象存储签名 URL 密钥（storage-service sign_keys）"
        }
      }
    },
    "defaults": {
      "$ref": "#/definitions/workload"
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "workloads"
        ],
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "object"
          },
          "workloads": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/definitions/workload"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
      "description": "部署命名空间（DNS label）"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "migrate": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        },
        "maxSurge": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "serviceType": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "serviceAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
